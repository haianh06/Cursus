# ============================================
# Cursus — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!
# Hướng dẫn đầy đủ: RUNNING.md

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ---- LLM (Google Gemini — xem ADR-002, đây là provider duy nhất được dùng thật) ----
GOOGLE_API_KEY=your-gemini-api-key-here

# ---- Database (BẮT BUỘC) ----
# Postgres — vd. connection string pooler của Supabase (xem ADR-001).
# App crash ngay lúc start nếu thiếu biến này (không có giá trị mặc định trong src/config.py).
DATABASE_URL=postgresql://user:password@localhost:5432/appdb
# SQLite chạy được về mặt kỹ thuật nhưng chưa test đầy đủ với migrations/seed:
# DATABASE_URL=sqlite:///./data/app.db

# ---- Redis (tuỳ chọn — chỉ dùng cho rate limiting, không set thì tự fallback) ----
# REDIS_URL=redis://localhost:6379/0

# ---- Auth - JWT (BẮT BUỘC, tối thiểu 32 ký tự) ----
# App crash ngay lúc start nếu thiếu hoặc dưới 32 ký tự. Tạo nhanh:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-characters-long

# ---- Auth - link base cho email xác thực / quên mật khẩu (trỏ về frontend) ----
EMAIL_VERIFICATION_URL_BASE=http://localhost:5173/email-verification
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password

# ---- Email (SMTP) ----
# Để "none" khi dev để không gửi mail thật / không tốn quota SMTP.
EMAIL_PROVIDER=none
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Cursus

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- AI Hook Logging (BTC cấp sẵn, giữ nguyên) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (override khi cần, mặc định frontend tự trỏ tới localhost:8000) ----
# Đặt trong frontend/.env, không phải file này:
# VITE_API_URL=http://localhost:8000/api/v1

# ---- Mock LMS SSO (mục 6.6, [MỚI 23/08]) ----
# Xác thực người xem web UI của Mock LMS bằng chính danh tính Cursus (không có
# tài khoản admin/mật khẩu riêng nào nữa). MOCK_LMS_SSO_SHARED_SECRET phải
# GIỐNG HỆT giá trị env cùng tên bên mock-lms/.env — đây không phải mật khẩu
# người dùng, chỉ xác minh lệnh gọi đổi mã lấy danh tính đến từ đúng server
# Mock LMS, không phải client giả mạo. Đổi mặc định dev trước khi deploy thật.
MOCK_LMS_SSO_SHARED_SECRET=dev-only-mock-lms-sso-secret
MOCK_LMS_BASE_URL=http://localhost:9000
MOCK_LMS_CLIENT_ID=cursus-tool
MOCK_LMS_CLIENT_SECRET=replace-with-a-local-oauth-secret
# Danh sách redirect_uri được phép nhận mã (an toàn: chặn ai đó lợi dụng
# endpoint /authorize để phát mã rồi redirect người dùng sang domain lạ).
MOCK_LMS_SSO_ALLOWED_REDIRECT_PREFIXES=http://127.0.0.1:9000,http://localhost:9000

# ---- Cursus Chat / ai-service (production readiness — ĐỌC KỸ TRƯỚC KHI DEPLOY) ----
# AI_SERVICE_INTERNAL_KEY: docker-compose.yml chỉ dùng "docker-local-ai-service-key"
# làm giá trị mặc định KHI biến này chưa được set — đây là placeholder cho dev,
# KHÔNG được dùng ở production. Sinh một secret thật, ví dụ:
#   openssl rand -hex 32
AI_SERVICE_INTERNAL_KEY=
OPENAI_API_KEY=
# Ngưỡng kỹ thuật chặn spam/vòng lặp lỗi — KHÔNG phải giới hạn ngân sách thật
# với OpenAI (code này không có quyền truy cập billing API của OpenAI). Tăng/
# giảm theo lưu lượng thực tế; mặc định là phán đoán kỹ thuật, chưa qua duyệt
# chính sách chi tiêu.
CURSUS_CHAT_RATE_LIMIT_PER_MINUTE=10
LLM_DAILY_REQUEST_LIMIT=2000
# Email nhận cảnh báo khủng hoảng tâm lý (bắt buộc phải set ở production —
# nếu để trống, cảnh báo chỉ được ghi log, KHÔNG ai được báo qua email) và
# cảnh báo vận hành khác (vượt hạn mức AI/ngày). Có thể dùng chung 1 địa chỉ.
CRISIS_ESCALATION_EMAIL=
OPS_ALERT_EMAIL=
# Số ngày giữ lại action-proposal/briefing-impression đã xử lý xong — giá trị
# mặc định (30/90 ngày) là lựa chọn kỹ thuật, CHƯA được duyệt theo chính sách
# bảo mật dữ liệu của trường. Cập nhật sau khi có quyết định chính thức.
CHAT_ACTION_PROPOSAL_RETENTION_DAYS=30
CHAT_BRIEFING_IMPRESSION_RETENTION_DAYS=90
