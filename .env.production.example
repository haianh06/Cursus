# ============================================
# Cursus — Production / VPS environment
# ============================================
# Copy to .env.production and fill real values.
# NEVER commit .env.production
#
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---- Public URLs (browser-facing) ----
# Backend API URL baked into the Vite build (must be reachable from users' browsers)
PUBLIC_API_URL=https://api.your-domain.com/api/v1
# Comma-separated origins allowed by CORS (frontend origin(s))
CORS_ORIGINS=https://app.your-domain.com
EMAIL_VERIFICATION_URL_BASE=https://app.your-domain.com
PASSWORD_RESET_URL_BASE=https://app.your-domain.com

# ---- Bind / ports on the host ----
HOST_BIND=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- Database ----
# Option A — compose Postgres (same host):
POSTGRES_USER=appuser
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=appdb
DATABASE_URL=postgresql://appuser:replace-with-strong-db-password@postgres:5432/appdb

# Option B — Supabase (recommended for shared prod):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# For Alembic migrations prefer direct 5432 (session) URL if pooler breaks DDL.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Redis ----
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0

# ---- Auth ----
JWT_SECRET_KEY=replace-with-64-char-random-secret-minimum-32
JWT_ALGORITHM=HS256
JWT_ISSUER=neural-forge-auth
JWT_AUDIENCE=neural-forge-clients
JWT_ACCESS_TOKEN_MINUTES=15
ACCESS_TOKEN_COOKIE_SAMESITE=lax
REFRESH_TOKEN_COOKIE_SAMESITE=strict

# ---- App ----
APP_ENV=production
SEED_ON_START=false
RATE_LIMIT_ENABLED=true
CSRF_PROTECTION_ENABLED=true
LOG_LEVEL=INFO

# ---- LLM ----
GOOGLE_API_KEY=your-google-api-key-here
MODEL_NAME=gemini-2.5-flash

# ---- Email (required for real verify/reset in production) ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=Cursus
SMTP_USE_TLS=true

# ---- AI logging (optional) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log
