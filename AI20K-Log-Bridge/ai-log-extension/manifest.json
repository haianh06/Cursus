{
  "manifest_version": 3,
  "name": "AI20K Log Bridge",
  "version": "2.0.0",
  "description": "Bat prompt AI tren moi trang chat, cho ban duyet truoc khi gui len grading server AI20K.",
  "minimum_chrome_version": "111",

  "key": "",

  "permissions": ["storage", "scripting", "alarms", "tabs", "nativeMessaging"],

  "host_permissions": ["*://*/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "AI20K Log Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["detector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
